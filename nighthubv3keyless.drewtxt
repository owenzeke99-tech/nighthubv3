-- [[ Night Hub - Key System (Black & White Theme - 24H Key Saving) ]]
-- Key: NightHubV3NakwowojejeoLapqowhjeoeeijeiei

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local PlayerGui = Player:FindFirstChild("PlayerGui") or CoreGui

-- Cấu hình Key & Link
local KEY_FILE = "NightHub_StealAnEggs_Key.json"
local correctKey = "NightHubV3NakwowojejeoLapqowhjeoeeijeiei"
local getKeyLink = "https://link4m.net/o4it4"
local KEY_DURATION = 86400 -- 24 giờ tính bằng giây (24 * 60 * 60)

-- Kiểm tra xem Key ẩn đã lưu còn hiệu lực hay không (trong vòng 24h)
local function isKeySaved()
	if writefile and readfile and isfile then
		if isfile(KEY_FILE) then
			local success, data = pcall(function()
				return HttpService:JSONDecode(readfile(KEY_FILE))
			end)
			if success and type(data) == "table" then
				if data.Key == correctKey and data.ExpireTime then
					if os.time() < data.ExpireTime then
						return true
					end
				end
			end
		end
	end
	return false
end

-- Lưu Key ẩn kèm mốc thời gian hết hạn (24h)
local function saveKey()
	if writefile then
		pcall(function()
			local saveData = {
				Key = correctKey,
				ExpireTime = os.time() + KEY_DURATION
			}
			writefile(KEY_FILE, HttpService:JSONEncode(saveData))
		end)
	end
end

-- Hàm chạy script chính sau khi xác minh Key thành công
local function runMainScript()
	print("Key verified! Executing Night Hub script...")
	loadstring(game:HttpGet("https://raw.githubusercontent.com/WhiteX1208/Scripts/refs/heads/main/StealAnEggs.luau"))()
end

-- Tự động bỏ qua Key Menu nếu đã lưu Key còn hiệu lực
if isKeySaved() then
	runMainScript()
	return
end

-- Clear UI cũ nếu tồn tại
if PlayerGui:FindFirstChild("NightHubKeySystem") then
	PlayerGui.NightHubKeySystem:Destroy()
end

-- Tạo GUI Chính
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NightHubKeySystem"
ScreenGui.Parent = PlayerGui
ScreenGui.ResetOnSpawn = false

